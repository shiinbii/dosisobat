# Backend environment variables — copy to `.env` and fill in

# Local Postgres (via docker-compose)
DATABASE_URL="postgresql://dosis:dosis_dev_password@localhost:5432/dosis_obat"
DIRECT_URL="postgresql://dosis:dosis_dev_password@localhost:5432/dosis_obat"

# --- Supabase (uncomment & isi kalau pakai Supabase) ---
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="please-generate-a-long-random-string-here"
PORT=3000
NODE_ENV=development

# Default admin (used by seed script). CHANGE these in production.
ADMIN_EMAIL="admin@dosis.app"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Default Admin"
